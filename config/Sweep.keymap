#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };

        homerow_mods: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        layout_homerow: layout_homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYOUT_HOMEROW";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q                     &kp W                       &kp E                  &kp R                         &kp T      &kp Y       &kp U                     &kp I                          &kp O                        &kp BACKSPACE
&homerow_mods LEFT_ALT A  &homerow_mods LEFT_SHIFT S  &homerow_mods LCTRL D  &homerow_mods LEFT_COMMAND F  &kp G      &kp H       &homerow_mods RGUI J      &homerow_mods RIGHT_CONTROL K  &homerow_mods RIGHT_SHIFT L  &homerow_mods RIGHT_ALT P
&kp Z                     &kp X                       &kp C                  &kp V                         &kp B      &kp N       &kp M                     &kp COMMA                      &kp DOT                      &kp COLON
                                                                             &layout_homerow 2 TAB         &kp SPACE  &kp RETURN  &layout_homerow 1 DELETE
            >;
        };

        Navigation {
            display-name = "Navigation";
            bindings = <
&kp N1  &kp N2      &kp N3             &kp N4           &kp N5         &kp N6              &kp N7        &kp N8          &kp N9     &kp N0
&kp F1  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp PAGE_UP    &kp LS(LEFT_ARROW)  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp F10
&kp F2  &kp F3      &kp F4             &kp F5           &kp PAGE_DOWN  &kp F6              &kp F7        &kp F8          &kp F9     &kp F11
                                       &trans           &trans         &trans              &trans
            >;

            label = "lower_layer";
        };

        Symbol {
            display-name = "Symbol";
            bindings = <
&kp ESCAPE                          &kp DOUBLE_QUOTES            &kp LESS_THAN                    &kp GREATER_THAN           &kp SLASH     &kp UNDERSCORE  &kp LEFT_PARENTHESIS             &kp RIGHT_PARENTHESIS                      &kp TILDE                        &kp NON_US_BACKSLASH
&homerow_mods LEFT_ALT EXCLAMATION  &homerow_mods LEFT_SHIFT AT  &homerow_mods LEFT_CONTROL HASH  &homerow_mods LGUI DOLLAR  &kp PERCENT   &kp PLUS        &homerow_mods RGUI LEFT_BRACKET  &homerow_mods RIGHT_CONTROL RIGHT_BRACKET  &homerow_mods RIGHT_SHIFT EQUAL  &homerow_mods RIGHT_ALT SINGLE_QUOTE
&kp TAB                             &kp PIPE                     &kp LCTRL                        &kp AMPERSAND              &kp ASTERISK  &kp MINUS       &kp LEFT_BRACE                   &kp RIGHT_BRACE                            &kp GRAVE                        &kp QUESTION
                                                                                                  &trans                     &trans        &trans          &trans
            >;
        };
    };
};
